+/** @brief 为 Filament 注册随当前 MuJoCo SDK 搬迁的只读 shader/IBL 资源。
+ * 仅在创建 GPU context 前由主线程调用；已注册同前缀时沿用官方进程级资源表。
+ */
+void RegisterFilamentResources() {
+  if (mjp_findProvider("filament:") != nullptr) return;
+
+  // 以实际加载的引擎动态库定位 SDK，既不依赖 CWD，也不把构建机路径写入发布包。
+  mjpResourceProvider provider;
+  mjp_defaultProvider(&provider);
+  provider.prefix = "filament";
+  provider.open = [](mjResource* resource) {
+    Dl_info module{};
+    if (!dladdr(dlsym(RTLD_DEFAULT, "mj_version"), &module) || !module.dli_fname) return 0;
+    const auto path = std::filesystem::path(module.dli_fname).parent_path().parent_path() /
+                      "share/mujoco/filament" / (resource->name + std::strlen("filament:"));
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file) return 0;
+    const auto length = file.tellg();
+    if (length <= 0 || length > INT_MAX) return 0;
+    auto bytes = std::make_unique<std::vector<char>>(static_cast<size_t>(length));
+    file.seekg(0);
+    if (!file.read(bytes->data(), length)) return 0;
+    resource->data = bytes.release();
+    return 1;
+  };
+  provider.read = [](mjResource* resource, const void** buffer) {
+    const auto& bytes = *static_cast<std::vector<char>*>(resource->data);
+    *buffer = bytes.data();
+    return static_cast<int>(bytes.size());
+  };
+  provider.close = [](mjResource* resource) {
+    delete static_cast<std::vector<char>*>(resource->data);
+    resource->data = nullptr;
+  };
+  if (mjp_registerProvider(&provider) < 0) mju_error("Could not register Filament SDK resources");
+}
