+Simulate::~Simulate() {
+  FreeFilament();
+}
+
+void Simulate::FreeFilament() {
+  // 销毁顺序保证材质和网格所引用的 scene/context 仍然有效。
+  filament_user_meshes_.clear();
+  filament_user_decor_.clear();
+  filament_decorations_.reset();
+  filament_renderables_.reset();
+  filament_lights_.reset();
+  filament_resources_.reset();
+  if (filament_target_) mjrf_destroyRenderTarget(filament_target_);
+  if (filament_scene_) mjrf_destroyScene(filament_scene_);
+  if (filament_context_) mjrf_destroyContext(filament_context_);
+  filament_target_ = nullptr;
+  filament_scene_ = nullptr;
+  filament_context_ = nullptr;
+  filament_pixels_.clear();
+  filament_labels_.clear();
+}
+
+void Simulate::InitFilament(const mjModel* model) {
+  RegisterFilamentResources();
+
+  // Vulkan 离屏目标与 GLFW 的二维 OpenGL 上下文分离，避免隐式切换当前上下文。
+  mjrfContextConfig context_config;
+  mjrf_defaultContextConfig(&context_config);
+  context_config.graphics_api = mjGRAPHICS_API_VULKAN;
+  filament_context_ = mjrf_createContext(&context_config);
+  mjrfSceneParams scene_params;
+  mjrf_defaultSceneParams(&scene_params);
+  filament_scene_ = mjrf_createScene(filament_context_, &scene_params);
+  mjrf_configureSceneFromModel(filament_scene_, model);
+
+  // 复用官方缓存管理器；每帧仅同步位姿，不重建树林和建筑的网格或材质。
+  filament_resources_ = std::make_unique<ModelResources>(model, filament_context_);
+  filament_renderables_ = std::make_unique<ModelRenderables>(filament_scene_, filament_resources_.get());
+  filament_lights_ = std::make_unique<ModelLights>(filament_scene_, filament_resources_.get());
+  filament_decorations_ = std::make_unique<ModelDecorations>(filament_context_, filament_scene_, model, kMaxGeom);
+  mjrfRenderTargetConfig target_config;
+  mjrf_defaultRenderTargetConfig(&target_config);
+  target_config.color_format = mjPIXEL_FORMAT_RGB8;
+  target_config.depth_format = mjPIXEL_FORMAT_DEPTH32F;
+  filament_target_ = mjrf_createRenderTarget(filament_context_, &target_config);
+}
+
+void Simulate::SyncFilament(const mjModel* model, mjData* data) {
+  if (!filament_context_ || !model || !data) return;
+
+  // 上帧额外显示的隐藏 mesh 不属于默认模型可见组，先移除再同步当前可见性。
+  for (auto* renderable : filament_user_meshes_) mjrf_removeSceneRenderable(filament_scene_, renderable);
+  filament_user_meshes_.clear();
+  filament_user_decor_.clear();
+  filament_lights_->Update(data);
+  filament_renderables_->SetOptions(opt);
+  if (pert.select > 0) filament_renderables_->MarkAsSelected(mjOBJ_BODY, pert.select);
+  else if (pert.flexselect >= 0) filament_renderables_->MarkAsSelected(mjOBJ_FLEX, pert.flexselect);
+  else if (pert.skinselect >= 0) filament_renderables_->MarkAsSelected(mjOBJ_SKIN, pert.skinselect);
+  else filament_renderables_->MarkAsSelected(mjOBJ_UNKNOWN, -1);
+  filament_renderables_->Update(data);
+
+  // 桨叶来自隐藏的 group 3 模型 mesh；只覆盖显示位姿，不修改 mjData 或动力学。
+  for (const auto& geom : user_scn_geoms_) {
+    if (geom.objtype == mjOBJ_GEOM && geom.objid >= 0 && geom.objid < model->ngeom &&
+        !opt.geomgroup[model->geom_group[geom.objid]]) {
+      if (auto* renderable = filament_renderables_->GetRenderable(mjOBJ_GEOM, geom.objid)) {
+        mjrf_setRenderablePose(renderable, geom.pos, geom.mat);
+        mjrf_addSceneRenderable(filament_scene_, renderable);
+        filament_user_meshes_.push_back(renderable);
+      }
+    } else {
+      filament_user_decor_.push_back(geom);
+    }
+  }
+
+  // 坐标轴、接触点等非模型装饰使用官方动态装饰路径；相机仍由原查看器维护。
+  filament_labels_.clear();
+  const mjrRect viewport = uistate.rect[3];
+  if (viewport.width > 0 && viewport.height > 0) {
+    filament_decorations_->Update(data, &opt, &pert, &cam, viewport,
+        [this](const char* text, float x, float y, float z) {
+          if (z >= -1 && z <= 1) filament_labels_.emplace_back(text, .5f * (x + 1), .5f * (y + 1));
+        }, filament_user_decor_);
+  }
+}
+
+void Simulate::RenderFilament(mjrRect viewport) {
+  if (!filament_context_ || viewport.width <= 0 || viewport.height <= 0) return;
+
+  // 目标尺寸跟随窗口；像素缓冲在尺寸不变时复用，仿真线程在 GPU 绘制期间继续推进。
+  mjrf_resizeRenderTarget(filament_target_, viewport.width, viewport.height);
+  filament_pixels_.resize(static_cast<size_t>(viewport.width) * viewport.height * 3);
+  mjrfRenderRequest request;
+  mjrf_defaultRenderRequest(&request);
+  request.scene = filament_scene_;
+  request.target = filament_target_;
+  request.viewport = {0, 0, viewport.width, viewport.height};
+  request.camera = mjv_averageCamera(scn.camera, scn.camera + 1);
+  request.shadows = scn.flags[mjRND_SHADOW];
+  request.reflections = scn.flags[mjRND_REFLECTION];
+  request.skybox = scn.flags[mjRND_SKYBOX];
+  request.haze = scn.flags[mjRND_HAZE];
+  request.post_processing = scn.flags[mjRND_POST_PROCESSING];
+  request.headlight_intensity = filament_lights_->GetHeadlightIntensity();
+  {
+    // passive 模型的可视参数会在 Sync 中修改；仅拷贝参数时持锁，GPU 工作不持锁。
+    const MutexLock lock(mtx);
+    const auto& headlight = filament_resources_->GetModel()->vis.headlight;
+    request.headlight = headlight.active;
+    std::copy_n(headlight.diffuse, 3, request.headlight_color);
+  }
+  if (scn.flags[mjRND_SEGMENT]) {
+    request.draw_mode = scn.flags[mjRND_IDCOLOR] ? mjDRAW_MODE_SEGMENTATION_BY_ID : mjDRAW_MODE_SEGMENTATION_BY_COLOR;
+  } else if (scn.flags[mjRND_DEPTH]) {
+    request.draw_mode = mjDRAW_MODE_DEPTH;
+  } else if (scn.flags[mjRND_WIREFRAME]) {
+    request.draw_mode = mjDRAW_MODE_WIREFRAME;
+  } else if (opt.flags[mjVIS_ISLAND]) {
+    request.draw_mode = mjDRAW_MODE_ISLANDS;
+  }
+
+  // 官方 mjrf 没有导出共享 GL 纹理的接口，等待这一帧读回完成后再交给二维合成。
+  mjrfReadRequest read;
+  mjrf_defaultReadRequest(&read);
+  read.target = filament_target_;
+  read.output = filament_pixels_.data();
+  read.num_bytes = filament_pixels_.size();
+  const auto frame = mjrf_render(filament_context_, &request, 1, &read, 1);
+  mjrf_waitForFrame(filament_context_, frame);
+
+  // Filament 的读回以图像顶行为起点，而 glDrawPixels 从底行开始；仅转换像素行序。
+  const size_t stride = static_cast<size_t>(viewport.width) * 3;
+  for (int row = 0; row < viewport.height / 2; ++row) {
+    auto top = filament_pixels_.begin() + row * stride;
+    auto bottom = filament_pixels_.begin() + (viewport.height - row - 1) * stride;
+    std::swap_ranges(top, top + stride, bottom);
+  }
+  mjr_restoreBuffer(&platform_ui->mjr_context());
+  mjr_rectangle(viewport, 0, 0, 0, 1);
+  mjr_drawPixels(filament_pixels_.data(), nullptr, viewport, &platform_ui->mjr_context());
+  for (const auto& [text, x, y] : filament_labels_) {
+    mjr_text(mjFONT_NORMAL, text.c_str(), &platform_ui->mjr_context(), x, y, 1, 1, 1);
+  }
+}
