# BASE_IMAGE may be another already available Ubuntu 20.04 image.
ARG BASE_IMAGE=ubuntu:20.04
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
COPY docker/toolchain.asc /usr/share/keyrings/ubuntu-toolchain.asc
RUN . /etc/os-release && test "$VERSION_ID" = 20.04 && \
    rm -f /etc/apt/apt.conf.d/docker-clean /etc/apt/sources.list.d/ros*.list && \
    echo 'Acquire::Retries "5"; Acquire::http::Timeout "30";' > /etc/apt/apt.conf.d/80-retries && \
    echo 'deb [signed-by=/usr/share/keyrings/ubuntu-toolchain.asc] http://ppa.launchpad.net/ubuntu-toolchain-r/test/ubuntu focal main' > /etc/apt/sources.list.d/toolchain.list
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gcc-11 g++-11 make git curl python3 python3-pip patchelf binutils \
    libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev libgl-dev
RUN python3 -m pip install --no-cache-dir cmake==3.28.4
RUN ln -s /usr/bin/gcc-11 /usr/local/bin/gcc && \
    ln -s /usr/bin/g++-11 /usr/local/bin/g++ && \
    ln -s /usr/bin/gcc-11 /usr/local/bin/cc && \
    ln -s /usr/bin/g++-11 /usr/local/bin/c++
ENV CC=gcc-11 CXX=g++-11
WORKDIR /workspace

ENTRYPOINT []
